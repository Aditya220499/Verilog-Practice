:vpi_module "C:\iverilog\lib\ivl\va_math.vpi";
S_0000029ee86b9f70 .scope module, "delta_cycle_demo" "delta_cycle_demo" 2 2;
 .timescale -9 -12;
v0000029ee86d2f80_0 .var "a", 0 0;
v0000029ee86d2de0_0 .var "b", 0 0;
v0000029ee86bb9f0_0 .var "c", 0 0;
E_0000029ee86b8b60 .event anyedge, v0000029ee86d2de0_0;
E_0000029ee86b87e0 .event anyedge, v0000029ee86d2f80_0;
    .scope S_0000029ee86b9f70;
T_0 ;
    %wait E_0000029ee86b87e0;
    %load/vec4 v0000029ee86d2f80_0;
    %store/vec4 v0000029ee86d2de0_0, 0, 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0000029ee86b9f70;
T_1 ;
    %wait E_0000029ee86b8b60;
    %load/vec4 v0000029ee86d2de0_0;
    %store/vec4 v0000029ee86bb9f0_0, 0, 1;
    %jmp T_1;
    .thread T_1, $push;
    .scope S_0000029ee86b9f70;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0000029ee86d2f80_0, 0, 1;
    %delay 5000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0000029ee86d2f80_0, 0, 1;
    %vpi_call 2 11 "$strobe", "strobe  at t=%0t : a=%b b=%b c=%b", $time, v0000029ee86d2f80_0, v0000029ee86d2de0_0, v0000029ee86bb9f0_0 {0 0 0};
    %vpi_call 2 12 "$display", "T=%0t | After a change: a=%b b=%b c=%b", $time, v0000029ee86d2f80_0, v0000029ee86d2de0_0, v0000029ee86bb9f0_0 {0 0 0};
    %delay 0, 0;
    %vpi_call 2 13 "$display", "T=%0t | After delta: a=%b b=%b c=%b", $time, v0000029ee86d2f80_0, v0000029ee86d2de0_0, v0000029ee86bb9f0_0 {0 0 0};
    %delay 1000, 0;
    %vpi_call 2 14 "$finish" {0 0 0};
    %end;
    .thread T_2;
